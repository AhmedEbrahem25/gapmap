# Copy to .env.local and fill in. Never commit .env.local.

# Required in production: at least 32 random characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Live AI — set ONE of these. Leave both empty to run the offline demo logic.
#
# Option A (free): Google Gemini key from https://aistudio.google.com/apikey — no credit card.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-flash-latest          # copy an exact ID from AI Studio if you want a specific model
# GEMINI_MODEL_FAST=gemini-flash-lite-latest
#
# Option B (paid): Anthropic Claude key from https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5
#
# If both keys are set, Gemini is used unless you set AI_PROVIDER=anthropic.
# AI_PROVIDER=gemini

# Local storage
# DATABASE_PATH=data/gapmap.db
# STORAGE_DIR=storage

# Demo helpers (one-click logins and "Reset demo data"). Set to false in a real deployment.
DEMO_MODE=true

# Only for demoing a production build over plain http on a LAN address.
# COOKIE_SECURE=false
