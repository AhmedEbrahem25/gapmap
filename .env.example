# Copy to .env.local and fill in. Never commit .env.local.

# Required in production: at least 32 random characters.
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Live AI. Leave empty to run the offline demo logic (no handwriting reading).
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_MODEL_FAST=claude-haiku-5-5

# Local storage
# DATABASE_PATH=data/gapmap.db
# STORAGE_DIR=storage

# Demo helpers (one-click logins and "Reset demo data"). Set to false in a real deployment.
DEMO_MODE=true

# Only for demoing a production build over plain http on a LAN address.
# COOKIE_SECURE=false
